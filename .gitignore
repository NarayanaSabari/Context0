# Binaries
bin/
*.exe
*.dll
*.so
*.dylib

# Binaries built into the repo root by `go build ./cmd/...` without -o, which
# names them after their package directory. 15-27MB each and easy to commit by
# accident, since the bin/ rule above does not cover them.
/cli
/server
/consolidate

# Go build artifacts
# NOTE: api/gen/ is committed (standard Go practice for proto generated code)
coverage.out
coverage.html

# Node / Web
node_modules/
web/dist/
web/.vite/

# Python
__pycache__/
*.pyc
*.egg-info/
dist/
build/
*.whl

# IDE
.idea/
.vscode/
*.swp
*.swo
.claude/

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Docker
*.tar

# Secrets (never commit)
*.pem
*.key

# Local dev credentials generated by `make deploy`. Never commit.
.dev-credentials

# Marketing site build output and local artifacts
site/dist/
site/.shots/
site/.vite/

# Design swarm working files (concepts, screenshots, harness)
.design/
.lavish/
