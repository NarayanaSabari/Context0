# Copy to .env and fill in real values. Never commit .env.
#
# Point the chaser at a running Kora (docker compose up -d from the repo
# root, then a key from KORA_API_KEYS in the repo's own .env):
KORA_URL=http://localhost:8080
KORA_API_KEY=

# Only needed for `python -m chaser run --live`, and only test-mode keys --
# see https://razorpay.com/docs/api/. Leave unset to stay in recorded mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: reword the deterministic templates through an OpenAI-compatible
# chat endpoint. Wording only -- the policy engine never calls this. Unset
# either of the first two and the chaser falls back to the plain template.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
