# Git attributes: normalize line endings and keep generated files out of diffs.
#
# linguist-generated hides a file from pull request diffs by default and
# excludes it from the repository language statistics. That matters here
# because api/gen/ is 3,896 lines of protoc-gen-go output committed to the
# repo, which is standard Go practice but means a proto change produces a diff
# nobody can read. The file is still versioned and still reviewable on request
# by expanding it; `make proto-gen` regenerates it from api/proto/.
#
# The lockfiles get the same treatment for the same reason: 2,094 lines that
# are the deterministic result of a manifest change, not something to read
# line by line.

# Normalize to LF in the repository, whatever the working tree uses.
* text=auto eol=lf

# Windows-native and generated-binary files must not be converted.
*.png binary
*.jpg binary
*.ico binary
*.mp4 binary
*.MOV binary
*.pdf binary

# Shell scripts and Makefiles break on CRLF.
*.sh text eol=lf
Makefile text eol=lf

# Generated by protoc-gen-go, protoc-gen-go-grpc, and protoc-gen-grpc-gateway
# via `make proto-gen`. Regenerated from api/proto/ on every change.
api/gen/** linguist-generated=true

# Deterministic output of a manifest change.
pnpm-lock.yaml linguist-generated=true
go.sum linguist-generated=true

# The site's archived design concepts are reference artifacts, not the
# shipping site; counting them skews the language stats toward HTML.
site/design-archive/** linguist-documentation=true
